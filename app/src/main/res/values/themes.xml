<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Main App Theme -->
    <style name="Theme.HostelManagementSystem" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorPrimaryVariant">@color/primaryColorVariant</item>
        <item name="colorOnPrimary">@color/onPrimary</item>

        <!-- Secondary brand colors -->
        <item name="colorSecondary">@color/secondaryColor</item>
        <item name="colorOnSecondary">@color/onSecondary</item>

        <!-- Background and surface -->
        <item name="android:colorBackground">@color/backgroundColor</item>
        <item name="colorSurface">@color/surfaceColor</item>
        <item name="colorOnSurface">@color/onSurface</item>

        <!-- Error colors -->
        <item name="colorError">@color/errorColor</item>
        <item name="colorOnError">@color/onError</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>


        <!-- Other theme settings -->
        <item name="android:statusBarColor">@color/primaryColorVariant</item>
        <item name="android:navigationBarColor">@color/backgroundColor</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.HostelManagementSystem.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
    </style>

</resources>
